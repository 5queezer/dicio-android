<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- the benchmark reaches its LLM server on the host over plain http (10.0.2.2) -->
    <application android:usesCleartextTraffic="true">
        <receiver
            android:name="org.stypox.dicio.eval.EvalInputReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver"
            xmlns:tools="http://schemas.android.com/tools">
            <intent-filter>
                <action android:name="org.stypox.dicio.EVAL_INPUT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
